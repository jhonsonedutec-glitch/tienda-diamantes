# ------------------------------
# API
# ------------------------------
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

# PostgreSQL local o Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freefire_sales?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Seguridad
JWT_ADMIN_SECRET=change-this-with-at-least-32-random-characters
JWT_ADMIN_EXPIRES_IN=8h
ORDER_TTL_MINUTES=30
MAX_RECEIPT_MB=5

# Administrador inicial (solo para npm run db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-123456
ADMIN_NAME=Administrador

# Yape manual
YAPE_HOLDER=Nombre del titular
YAPE_PHONE=999999999
YAPE_QR_URL=https://example.com/qr-yape.png

# BCP manual
BCP_HOLDER=Nombre del titular
BCP_ACCOUNT=000-0000000-0-00
BCP_CCI=002-000-000000000000-00

# Storage: local o supabase
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=../../data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=payment-receipts

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_LANGUAGE_CODE=es_PE
WHATSAPP_ALLOW_TEXT_MESSAGES=true
WHATSAPP_TEMPLATE_ORDER_CREATED=
WHATSAPP_TEMPLATE_RECEIPT_RECEIVED=
WHATSAPP_TEMPLATE_PAYMENT_APPROVED=
WHATSAPP_TEMPLATE_PAYMENT_REJECTED=
WHATSAPP_TEMPLATE_ORDER_COMPLETED=
